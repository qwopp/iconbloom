{
  "name": "Peach Sunset",
  "palette": {
    "light": "#FFEDE3",
    "main": "#FFB38F",
    "deep": "#EE8158",
    "ink": "#A0503A",
    "accent": "#FF9EB8",
    "peach": "#FFD27A",
    "cream": "#FFF8F1"
  },
  "decor": {
    "fill": "#FFB894",
    "fill_dark": "#FFA37A",
    "fill_deep": "#FFD27A",
    "outline": "#C25E3F",
    "shine": "#FFEDE3",
    "deep": "#EE8158",
    "accent": "#FF9EB8",
    "blush": "#FF7F86",
    "eye": "#3D2620"
  },
  "assets": {
    "bow": "bow.png",
    "heart": "heart.png",
    "face": "face.png",
    "sparkle": "sparkle.png",
    "sun": "sun.png",
    "flower": "flower.png",
    "star": "star.png"
  },
  "recipes": [
    {"use": "pastel_recolor", "label": "Sunset recolor"},
    {"id": "gradient_sunset", "label": "Peach to pink", "family": "gradient",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["#FF9466", "#F57D9C"], "angle": 45}]},
    {"use": "mono_rose", "label": "Mono coral on cream"},
    {"use": "bubble_pink", "label": "Bubble tile, peach"},
    {"id": "sunset_recolor", "label": "Rosy recolor", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["accent", "main", "light"], ["accent", "peach", "main"]]},
             {"op": "sticker_outline", "thickness": 10, "color": "#FFFFFF"}]},
    {"use": "sticker_face", "label": "Sticker + blush"},
    {"id": "dot_tile", "label": "Polka-dot tile", "family": "pattern",
     "ops": [{"op": "tile", "fill": [["light"], ["cream"]], "pattern": "dots", "pattern_color": ["main", "accent"], "outline": "main"}]},
    {"use": "recolor_tile", "label": "Recolor on cream tile"},
    {"id": "glow_sunset", "label": "Tint + sun", "family": "glow",
     "ops": [{"op": "tint", "stops": ["ink", "main", "light"]},
             {"op": "glow", "color": "#FFFFFF", "radius": 8, "strength": 0.9},
             {"op": "badge", "asset": ["sun", "sparkle"], "corner": "top-right", "scale": 0.38, "rotation": 0}]},
    {"id": "gingham_sunset", "label": "Gingham tile + heart", "family": "pattern",
     "ops": [{"op": "tile", "fill": "cream", "pattern": "gingham", "pattern_color": ["main", "accent"], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["heart", "flower"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"use": "soft_tint", "label": "Soft tint"},
    {"use": "pink_sticker", "label": "Peach sticker"},
    {"id": "accent_recolor_sunset", "label": "Golden recolor + sun", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["peach", "main", "light"], ["peach", "accent", "main"]]},
             {"op": "badge", "asset": ["sun", "heart"], "corner": "bottom-right", "scale": 0.36, "rotation": -10}]},
    {"id": "mono_sunset", "label": "Sunset tile", "family": "mono",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["#FFB36B", "#F07A7A"], "shape": "circle"},
             {"op": "badge", "asset": "sun", "corner": ["bottom-left", "bottom-right"], "scale": 0.42, "rotation": 0}]},
    {"use": "bubble_cream", "label": "Bubble tile, cream"},
    {"id": "halo_sunset", "label": "Coral glow", "family": "glow",
     "ops": [{"op": "tint", "stops": ["ink", "deep", "light"]},
             {"op": "glow", "color": "main", "radius": 12, "strength": 0.9}]},
    {"id": "striped_sunset", "label": "Striped tile + sun", "family": "pattern",
     "ops": [{"op": "tile", "fill": "light", "pattern": "stripes", "pattern_color": ["main", "accent"], "shape": "circle", "scale": 0.66},
             {"op": "badge", "asset": ["sun", "sparkle"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": -12}]},
    {"use": "sticker", "label": "Sticker"},
    {"id": "tile_sunset", "label": "Tile + flower", "family": "tile",
     "ops": [{"op": "tile", "fill": [["light"], ["cream"]], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["flower", "heart"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"id": "tint_sunset", "label": "Peach tint", "family": "tint",
     "ops": [{"op": "tint", "stops": [["ink", "main", "light"], ["ink", "accent", "light"]]}]}
  ]
}
