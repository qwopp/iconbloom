{
  "name": "Mint Matcha",
  "palette": {
    "light": "#E4F6EA",
    "main": "#86D4A6",
    "deep": "#4FA678",
    "ink": "#3C7A5A",
    "accent": "#F5B5CC",
    "peach": "#F2D47A",
    "cream": "#FBF8EE"
  },
  "decor": {
    "fill": "#B8E6C9",
    "fill_dark": "#9ED9B4",
    "fill_deep": "#F3D36B",
    "outline": "#4F8A68",
    "shine": "#EAF8EF",
    "deep": "#5FA37C",
    "accent": "#F6C3D5",
    "blush": "#F59AB0",
    "eye": "#2E3B33"
  },
  "assets": {
    "bow": "bow.png",
    "heart": "heart.png",
    "face": "face.png",
    "sparkle": "sparkle.png",
    "leaf": "leaf.png",
    "flower": "flower.png",
    "cloud": "cloud.png"
  },
  "recipes": [
    {"use": "pastel_recolor", "label": "Matcha recolor"},
    {"id": "gradient_matcha", "label": "Matcha to mint", "family": "gradient",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["#7CC46F", "#3FAE9A"], "angle": 45}]},
    {"use": "mono_rose", "label": "Mono matcha on cream"},
    {"use": "bubble_pink", "label": "Bubble tile, mint"},
    {"use": "lavender_recolor", "id": "matcha_recolor", "label": "Sakura recolor"},
    {"use": "sticker_face", "label": "Sticker + blush"},
    {"use": "polka_tile", "id": "dot_tile"},
    {"use": "recolor_tile", "label": "Recolor on cream tile"},
    {"id": "glow_matcha", "label": "Tint + leaf", "family": "glow",
     "ops": [{"op": "tint", "stops": ["ink", "main", "light"]},
             {"op": "glow", "color": "#FFFFFF", "radius": 8, "strength": 0.9},
             {"op": "badge", "asset": ["leaf", "sparkle"], "corner": "top-right", "scale": 0.38, "rotation": 0}]},
    {"id": "gingham_matcha", "label": "Gingham tile + flower", "family": "pattern",
     "ops": [{"op": "tile", "fill": "cream", "pattern": "gingham", "pattern_color": ["main", "accent"], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["flower", "leaf"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"use": "soft_tint", "label": "Soft tint"},
    {"use": "pink_sticker", "label": "Mint sticker"},
    {"id": "accent_recolor_matcha", "label": "Latte recolor + flower", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["peach", "main", "light"], ["peach", "accent", "main"]]},
             {"op": "badge", "asset": ["flower", "heart"], "corner": "bottom-right", "scale": 0.36, "rotation": -10}]},
    {"id": "mono_matcha", "label": "Cloud tile", "family": "mono",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["#6FC39A", "#4FA57F"], "shape": "circle"},
             {"op": "badge", "asset": "cloud", "corner": ["bottom-left", "bottom-right"], "scale": 0.42, "rotation": 0}]},
    {"use": "bubble_cream", "label": "Bubble tile, cream"},
    {"use": "rose_glow", "id": "halo_matcha", "label": "Mint glow"},
    {"id": "striped_matcha", "label": "Striped tile + leaf", "family": "pattern",
     "ops": [{"op": "tile", "fill": "light", "pattern": "stripes", "pattern_color": ["main", "accent"], "shape": "circle", "scale": 0.66},
             {"op": "badge", "asset": ["leaf", "sparkle"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": -12}]},
    {"use": "sticker", "label": "Sticker"},
    {"id": "tile_matcha", "label": "Tile + leaf", "family": "tile",
     "ops": [{"op": "tile", "fill": [["light"], ["cream"]], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["leaf", "flower"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"use": "pastel_tint", "id": "tint_matcha", "label": "Matcha tint"},
    "cutout",
    "cutout_recolor",
    "cutout_mono",
    "cutout_tile",
    "cutout_swap",
    "cutout_duotone",
    "cutout_tint",
    "cutout_sticker"
  ]
}
