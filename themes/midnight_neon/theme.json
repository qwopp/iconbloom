{
  "name": "Midnight Neon",
  "palette": {
    "light": "#E6F9FF",
    "main": "#FF5FD2",
    "deep": "#38E1FF",
    "ink": "#2A1F5C",
    "accent": "#A47CFF",
    "peach": "#FFE66B",
    "cream": "#161936"
  },
  "decor": {
    "fill": "#FF6FD8",
    "fill_dark": "#E54FC0",
    "fill_deep": "#38E1FF",
    "outline": "#1B1440",
    "shine": "#FFC9F1",
    "deep": "#38E1FF",
    "accent": "#A47CFF",
    "blush": "#FF8AD8",
    "eye": "#1B1440"
  },
  "assets": {
    "bow": "bow.png",
    "heart": "heart.png",
    "face": "face.png",
    "sparkle": "sparkle.png",
    "star": "star.png",
    "moon": "moon.png"
  },
  "recipes": [
    {"use": "pastel_recolor", "label": "Neon recolor"},
    {"use": "gradient_white", "label": "Pink to violet"},
    {"use": "mono_rose", "label": "Mono cyan on night"},
    {"use": "bubble_pink", "label": "Bubble tile, neon"},
    {"id": "neon_recolor", "label": "Cyan recolor", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["deep", "accent", "main"], ["deep", "main", "peach"]]},
             {"op": "sticker_outline", "thickness": 10, "color": "deep"}]},
    {"use": "sticker_face", "label": "Sticker + blush"},
    {"id": "dot_tile", "label": "Neon dot tile", "family": "pattern",
     "ops": [{"op": "tile", "fill": "cream", "pattern": "dots", "pattern_color": ["main", "deep"], "outline": "main"}]},
    {"use": "recolor_tile", "label": "Recolor on night tile"},
    {"id": "glow_neon", "label": "Glow + star", "family": "glow",
     "ops": [{"op": "tint", "stops": ["accent", "main", "light"]},
             {"op": "glow", "color": "deep", "radius": 8, "strength": 0.9},
             {"op": "badge", "asset": ["star", "sparkle"], "corner": "top-right", "scale": 0.38, "rotation": 0}]},
    {"id": "gingham_neon", "label": "Neon gingham + moon", "family": "pattern",
     "ops": [{"op": "tile", "fill": "cream", "pattern": "gingham", "pattern_color": ["main", "accent"], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["moon", "star"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"use": "soft_tint", "label": "Soft tint"},
    {"use": "pink_sticker", "label": "Neon sticker"},
    {"id": "accent_recolor_neon", "label": "Electric recolor + heart", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["peach", "main", "deep"], ["peach", "deep", "accent"]]},
             {"op": "badge", "asset": ["heart", "star"], "corner": "bottom-right", "scale": 0.36, "rotation": -10}]},
    {"id": "mono_neon", "label": "Synthwave tile", "family": "mono",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["main", "accent"], "shape": "circle"},
             {"op": "badge", "asset": "star", "corner": ["bottom-left", "bottom-right"], "scale": 0.42, "rotation": 0}]},
    {"use": "bubble_cream", "label": "Night tile"},
    {"id": "halo_neon", "label": "Cyan glow", "family": "glow",
     "ops": [{"op": "tint", "stops": ["accent", "deep", "light"]},
             {"op": "glow", "color": "main", "radius": 12, "strength": 0.9}]},
    {"id": "striped_neon", "label": "Neon stripes + star", "family": "pattern",
     "ops": [{"op": "tile", "fill": "cream", "pattern": "stripes", "pattern_color": ["main", "accent"], "shape": "circle", "scale": 0.66},
             {"op": "badge", "asset": ["star", "sparkle"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": -12}]},
    {"use": "sticker", "label": "Sticker"},
    {"id": "tile_neon", "label": "Night tile + star", "family": "tile",
     "ops": [{"op": "tile", "fill": "cream", "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["star", "moon"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"id": "tint_neon", "label": "Neon tint", "family": "tint",
     "ops": [{"op": "tint", "stops": [["accent", "main", "light"], ["accent", "deep", "light"]]}]},
    "cutout",
    "cutout_recolor",
    "cutout_mono",
    "cutout_tile",
    "cutout_swap",
    "cutout_duotone",
    "cutout_tint",
    "cutout_sticker"
  ]
}
