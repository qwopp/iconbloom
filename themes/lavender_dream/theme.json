{
  "name": "Lavender Dream",
  "palette": {
    "light": "#EFE8FF",
    "main": "#C3B1FF",
    "deep": "#9479E6",
    "ink": "#5B4A9E",
    "accent": "#FFC7E6",
    "peach": "#BFE0FF",
    "cream": "#FAF7FF"
  },
  "decor": {
    "fill": "#CDBDFF",
    "fill_dark": "#B8A4FA",
    "fill_deep": "#FFE08A",
    "outline": "#6E58B8",
    "shine": "#F3EEFF",
    "deep": "#9479E6",
    "accent": "#FFC7E6",
    "blush": "#FF9EC4",
    "eye": "#2F2648"
  },
  "assets": {
    "bow": "bow.png",
    "heart": "heart.png",
    "face": "face.png",
    "sparkle": "sparkle.png",
    "moon": "moon.png",
    "star": "star.png",
    "cloud": "cloud.png"
  },
  "recipes": [
    {"use": "pastel_recolor", "label": "Dreamy recolor"},
    {"id": "gradient_dream", "label": "Lavender to pink", "family": "gradient",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["#9C82F2", "#F293C6"], "angle": 45}]},
    {"use": "mono_rose", "label": "Mono violet on cream"},
    {"use": "bubble_pink", "label": "Bubble tile, lavender"},
    {"id": "dream_recolor", "label": "Sky recolor", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["peach", "main", "light"], ["peach", "accent", "main"]]},
             {"op": "sticker_outline", "thickness": 10, "color": "#FFFFFF"}]},
    {"use": "sticker_face", "label": "Sticker + blush"},
    {"id": "dot_tile", "label": "Polka-dot tile", "family": "pattern",
     "ops": [{"op": "tile", "fill": [["light"], ["cream"]], "pattern": "dots", "pattern_color": ["main", "accent"], "outline": "main"}]},
    {"use": "recolor_tile", "label": "Recolor on cream tile"},
    {"id": "glow_dream", "label": "Tint + star", "family": "glow",
     "ops": [{"op": "tint", "stops": ["ink", "main", "light"]},
             {"op": "glow", "color": "#FFFFFF", "radius": 8, "strength": 0.9},
             {"op": "badge", "asset": ["star", "sparkle"], "corner": "top-right", "scale": 0.38, "rotation": 0}]},
    {"id": "gingham_dream", "label": "Gingham tile + moon", "family": "pattern",
     "ops": [{"op": "tile", "fill": "cream", "pattern": "gingham", "pattern_color": ["main", "accent"], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["moon", "star"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"use": "soft_tint", "label": "Soft tint"},
    {"use": "pink_sticker", "label": "Lavender sticker"},
    {"id": "accent_recolor_dream", "label": "Pink recolor + moon", "family": "recolor",
     "ops": [{"op": "recolor", "stops": [["accent", "main", "light"], ["accent", "peach", "main"]]},
             {"op": "badge", "asset": ["moon", "heart"], "corner": "bottom-right", "scale": 0.36, "rotation": -10}]},
    {"id": "mono_dream", "label": "Night sky tile", "family": "mono",
     "ops": [{"op": "mono", "color": "#FFFFFF"},
             {"op": "tile", "fill": ["#7C6BD6", "#4E4291"], "shape": "circle"},
             {"op": "badge", "asset": "star", "corner": ["bottom-left", "bottom-right"], "scale": 0.42, "rotation": 0}]},
    {"use": "bubble_cream", "label": "Bubble tile, cream"},
    {"id": "halo_dream", "label": "Violet glow", "family": "glow",
     "ops": [{"op": "tint", "stops": ["ink", "deep", "light"]},
             {"op": "glow", "color": "main", "radius": 12, "strength": 0.9}]},
    {"id": "striped_dream", "label": "Striped tile + star", "family": "pattern",
     "ops": [{"op": "tile", "fill": "light", "pattern": "stripes", "pattern_color": ["main", "accent"], "shape": "circle", "scale": 0.66},
             {"op": "badge", "asset": ["star", "sparkle"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": -12}]},
    {"use": "sticker", "label": "Sticker"},
    {"id": "tile_dream", "label": "Tile + star", "family": "tile",
     "ops": [{"op": "tile", "fill": [["light"], ["cream"]], "shape": "squircle", "scale": 0.66},
             {"op": "badge", "asset": ["star", "moon"], "corner": ["top-right", "top-left"], "scale": 0.4, "rotation": 12}]},
    {"id": "tint_dream", "label": "Lavender tint", "family": "tint",
     "ops": [{"op": "tint", "stops": [["ink", "main", "light"], ["ink", "accent", "light"]]}]}
  ]
}
