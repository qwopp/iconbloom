/* Iconbloom: pastel, rounded, soft. Colors are named tokens filled in from app/ui/palette.py. */

* {
    font-family: "Nunito";
    font-size: 10.5pt;
    color: @text;
}

QMainWindow, #root {
    background: @window;
}

#title {
    font-size: 17pt;
    font-weight: 800;
    color: @title;
}

#heading {
    font-size: 13pt;
    font-weight: 700;
}

#detail, #legend, #popupCaption {
    color: @muted;
}

#card {
    background: @card;
    border: 1px solid @card_border;
    border-radius: 18px;
}

#grid, #previewScroll, #previewScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

#previewCard {
    background: @preview;
    border: 2px solid @preview_border;
    border-radius: 16px;
}

#previewCard:hover {
    border-color: @preview_hover_border;
}

#previewCard[selected="true"] {
    background: @preview_selected;
    border-color: @accent;
}

#cardCaption {
    font-size: 9.5pt;
}

#sizePopup {
    background: @card;
    border: 2px solid @preview_hover_border;
    border-radius: 12px;
}

QPushButton {
    border-radius: 14px;
    padding: 7px 16px;
    font-weight: 700;
    border: 2px solid transparent;
}

QPushButton[role="primary"] {
    background: @primary;
    color: @on_primary;
    padding: 8px 26px;
}

QPushButton[role="primary"]:hover {
    background: @primary_hover;
}

QPushButton[role="secondary"] {
    background: @card;
    border-color: @border;
}

QPushButton[role="secondary"]:hover {
    background: @hover;
    border-color: @hover_border;
}

QPushButton[role="danger"] {
    background: @card;
    border-color: @danger_border;
    color: @danger_text;
}

QPushButton[role="danger"]:hover {
    background: @danger_hover;
}

QPushButton:disabled {
    background: @disabled;
    border-color: @disabled_border;
    color: @disabled_text;
}

QComboBox {
    background: @card;
    border: 2px solid @border;
    border-radius: 12px;
    padding: 5px 12px;
    min-width: 140px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: @card;
    selection-background-color: @selected;
    border: 1px solid @border;
}

QSplitter::handle {
    background: transparent;
    width: 12px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: @border;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}

QStatusBar {
    background: transparent;
    color: @muted;
}

QToolTip {
    background: @card;
    color: @text;
    border: 1px solid @border;
    padding: 6px;
}

#search {
    background: @card;
    border: 2px solid @border;
    border-radius: 12px;
    padding: 6px 12px;
}

#search:focus {
    border-color: @accent;
}

QPushButton#tab {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 4px 10px;
    font-weight: 600;
    color: @muted;
}

QPushButton#tab:hover {
    background: @hover;
}

QPushButton#tab:checked {
    background: @selected;
    border-color: @preview_hover_border;
    color: @text;
}

QToolButton#more {
    background: @card;
    border: 2px solid @border;
    border-radius: 14px;
    padding: 7px 16px;
    font-weight: 700;
}

QToolButton#more::menu-indicator {
    image: none;
}

QToolButton#more:hover {
    background: @hover;
}

QMenu {
    background: @card;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 18px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: @selected;
}

#notice {
    background: @notice;
    border: 1px solid @notice_border;
    border-radius: 12px;
}

QToolButton#closeNotice {
    border: none;
    background: transparent;
    color: @icon_muted;
    padding: 4px;
}

#selectionStrip {
    background: @preview;
    border: 1px solid @preview_border;
    border-radius: 12px;
}
